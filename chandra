<script>

/* =========================================================
   LOGIN SYSTEM
========================================================= */

const accounts = {

    admin:{
        username:"admin",
        password:"admin123",
        role:"Administrator"
    },

    faculty:{
        username:"faculty",
        password:"faculty123",
        role:"Faculty"
    },

    student:{
        username:"student",
        password:"student123",
        role:"Student"
    }

};


document
.getElementById("loginForm")
.addEventListener("submit",function(e){

    e.preventDefault();

    const username =
        document.getElementById("loginUsername").value.trim();

    const password =
        document.getElementById("loginPassword").value;

    const role =
        document.getElementById("loginRole").value;

    const account = accounts[role];


    if(
        username === account.username &&
        password === account.password
    ){

        localStorage.setItem(
            "loggedIn",
            "true"
        );

        localStorage.setItem(
            "userRole",
            role
        );

        localStorage.setItem(
            "userName",
            username
        );

        document
        .getElementById("loginScreen")
        .style.display="none";

        setupUser(role);

        showToast(
            "Login successful!"
        );

    }else{

        alert(
            "Invalid username or password.\n\n"+
            "Admin: admin / admin123\n"+
            "Faculty: faculty / faculty123\n"+
            "Student: student / student123"
        );

    }

});


/* =========================================================
   SESSION CHECK
========================================================= */

window.addEventListener("load",function(){

    const loggedIn =
        localStorage.getItem("loggedIn");

    const role =
        localStorage.getItem("userRole");

    if(loggedIn === "true" && role){

        document
        .getElementById("loginScreen")
        .style.display="none";

        setupUser(role);

    }

    renderStudents();

});


/* =========================================================
   ROLE SETUP
========================================================= */

function setupUser(role){

    const account = accounts[role];

    document
    .getElementById("userName")
    .textContent =
        account.username.charAt(0).toUpperCase()+
        account.username.slice(1);

    document
    .getElementById("userRole")
    .textContent =
        account.role.toUpperCase();

    document
    .getElementById("welcomeText")
    .textContent =
        "Good Evening, "+
        account.role+
        " 👋";

    document
    .getElementById("profileName")
    .textContent =
        account.role;

    document
    .getElementById("profileRole")
    .textContent =
        account.role;


    /* Hide admin-only features */

    document
    .querySelectorAll(".admin-only")
    .forEach(item=>{

        if(role==="admin"){

            item.style.display="flex";

        }else{

            item.style.display="none";

        }

    });


    if(role==="student"){

        document
        .getElementById("welcomeText")
        .textContent =
            "Welcome back, Student 👋";

    }

    if(role==="faculty"){

        document
        .getElementById("welcomeText")
        .textContent =
            "Welcome back, Faculty 👋";

    }

}


/* =========================================================
   LOGOUT
========================================================= */

document
.getElementById("logoutBtn")
.addEventListener("click",function(){

    const confirmLogout =
        confirm(
            "Are you sure you want to logout?"
        );

    if(confirmLogout){

        localStorage.removeItem("loggedIn");
        localStorage.removeItem("userRole");
        localStorage.removeItem("userName");

        document
        .getElementById("loginScreen")
        .style.display="flex";

        document
        .getElementById("loginForm")
        .reset();

        showToast(
            "You have been logged out."
        );

    }

});


/* =========================================================
   NAVIGATION
========================================================= */

document
.querySelectorAll(".nav-item[data-page]")
.forEach(item=>{

    item.addEventListener("click",function(){

        const page =
            this.getAttribute("data-page");

        openPage(page);

    });

});


function openPage(pageId){

    document
    .querySelectorAll(".page")
    .forEach(page=>{

        page.classList.remove("active");

    });


    document
    .querySelectorAll(".nav-item")
    .forEach(item=>{

        item.classList.remove("active");

    });


    const page =
        document.getElementById(pageId);

    if(page){

        page.classList.add("active");

    }


    const nav =
        document.querySelector(
            `.nav-item[data-page="${pageId}"]`
        );

    if(nav){

        nav.classList.add("active");

    }


    document
    .getElementById("sidebar")
    .classList.remove("show");

}


/* =========================================================
   MOBILE SIDEBAR
========================================================= */

document
.getElementById("mobileMenu")
.addEventListener("click",function(){

    document
    .getElementById("sidebar")
    .classList.toggle("show");

});


/* =========================================================
   DARK MODE
========================================================= */

document
.getElementById("themeBtn")
.addEventListener("click",function(){

    document
    .body
    .classList
    .toggle("dark");

    const dark =
        document.body.classList.contains("dark");

    this.textContent =
        dark ? "☀️" : "🌙";

    localStorage.setItem(
        "darkMode",
        dark
    );

});


if(
    localStorage.getItem("darkMode")==="true"
){

    document.body.classList.add("dark");

    document.getElementById("themeBtn")
    .textContent="☀️";

}


/* =========================================================
   NOTIFICATIONS
========================================================= */

document
.getElementById("notificationBtn")
.addEventListener("click",function(){

    document
    .getElementById("notificationPanel")
    .classList.toggle("show");

});


function clearNotifications(){

    document
    .getElementById("notificationPanel")
    .innerHTML=`

        <h3 style="margin-bottom:10px">
            Notifications
        </h3>

        <p style="color:var(--muted);padding:15px 0">
            ✓ All notifications have been read.
        </p>

    `;

    showToast(
        "Notifications marked as read"
    );

}


/* =========================================================
   MODALS
========================================================= */

function openModal(id){

    document
    .getElementById(id)
    .classList.add("show");

}


function closeModal(id){

    document
    .getElementById(id)
    .classList.remove("show");

}


/* =========================================================
   STUDENT DATA
========================================================= */

let students =
JSON.parse(
    localStorage.getItem("students")
) || [

    {
        id:"STU001",
        name:"Arun Kumar",
        email:"arun@campus.edu",
        department:"Computer Science",
        year:"3rd Year"
    },

    {
        id:"STU002",
        name:"Priya Sharma",
        email:"priya@campus.edu",
        department:"Information Technology",
        year:"2nd Year"
    },

    {
        id:"STU003",
        name:"Rahul Singh",
        email:"rahul@campus.edu",
        department:"Electronics",
        year:"4th Year"
    },

    {
        id:"STU004",
        name:"Ananya Rao",
        email:"ananya@campus.edu",
        department:"Mechanical",
        year:"3rd Year"
    }

];


function saveStudents(){

    localStorage.setItem(
        "students",
        JSON.stringify(students)
    );

}


function renderStudents(){

    const body =
        document.getElementById("studentBody");

    if(!body)return;

    body.innerHTML="";


    students.forEach((student,index)=>{

        const row =
            document.createElement("tr");

        row.innerHTML=`

            <td>${student.id}</td>

            <td>
                <strong>${student.name}</strong>
            </td>

            <td>${student.email}</td>

            <td>${student.department}</td>

            <td>${student.year}</td>

            <td>
                <span class="status active">
                    Active
                </span>
            </td>

            <td>

                <button
                    class="btn btn-danger"
                    onclick="deleteStudent(${index})"
                >
                    Delete
                </button>

            </td>

        `;

        body.appendChild(row);

    });


    document
    .getElementById("totalStudents")
    .textContent =
        (2548 + students.length - 4)
        .toLocaleString();

}


function deleteStudent(index){

    if(
        confirm(
            "Delete this student?"
        )
    ){

        students.splice(index,1);

        saveStudents();

        renderStudents();

        showToast(
            "Student deleted successfully"
        );

    }

}


/* =========================================================
   ADD STUDENT
========================================================= */

document
.getElementById("studentForm")
.addEventListener("submit",function(e){

    e.preventDefault();


    const newStudent = {

        id:
            "STU"+
            String(students.length+1)
            .padStart(3,"0"),

        name:
            document
            .getElementById("studentName")
            .value,

        email:
            document
            .getElementById("studentEmail")
            .value,

        department:
            document
            .getElementById("studentDepartment")
            .value,

        year:
            document
            .getElementById("studentYear")
            .value

    };


    students.push(newStudent);

    saveStudents();

    renderStudents();

    closeModal("studentModal");

    this.reset();

    showToast(
        "Student added successfully!"
    );

});


