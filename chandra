        <span class="nav-icon">👨‍🏫</span>
        Faculty
    </div>

    <div class="nav-item" data-page="attendance">
        <span class="nav-icon">📋</span>
        Attendance
    </div>

    <div class="nav-item" data-page="courses">
        <span class="nav-icon">📚</span>
        Courses
    </div>

    <div class="nav-item" data-page="timetable">
        <span class="nav-icon">🗓️</span>
        Timetable
    </div>

    <div class="nav-item" data-page="fees">
        <span class="nav-icon">💰</span>
        Fees
    </div>

    <div class="nav-item" data-page="results">
        <span class="nav-icon">📝</span>
        Exams & Results
    </div>

    <div class="nav-item" data-page="library">
        <span class="nav-icon">📖</span>
        Library
    </div>

    <div class="nav-item" data-page="transport">
        <span class="nav-icon">🚌</span>
        Transport
    </div>

    <div class="nav-item" data-page="hostel">
        <span class="nav-icon">🏠</span>
        Hostel
    </div>

    <div class="menu-title">
        Campus
    </div>

    <div class="nav-item" data-page="events">
        <span class="nav-icon">🎉</span>
        Events
    </div>

    <div class="nav-item" data-page="notices">
        <span class="nav-icon">📢</span>
        Notices
    </div>

    <div class="nav-item" data-page="profile">
        <span class="nav-icon">👤</span>
        My Profile
    </div>

    <div class="menu-title">
        System
    </div>

    <div class="nav-item" data-page="settings">
        <span class="nav-icon">⚙️</span>
        Settings
    </div>

    <div class="nav-item" id="logoutBtn">
        <span class="nav-icon">🚪</span>
        Logout
    </div>

</aside>


<!-- =========================================================
     MAIN
========================================================= -->

<main class="main">

<header class="header">

    <div class="header-left">

        <span class="mobile-menu" id="mobileMenu">
            ☰
        </span>

        <input
            type="text"
            class="search"
            id="globalSearch"
            placeholder="Search..."
        >

    </div>

    <div class="header-right">

        <button
            class="header-btn"
            id="themeBtn"
            title="Toggle theme"
        >
            🌙
        </button>

        <button
            class="header-btn"
            id="notificationBtn"
        >
            🔔
        </button>

        <div class="profile">

            <img
                src="https://i.pravatar.cc/100?img=12"
                alt="Profile"
            >

            <div>
                <strong id="userName">
                    Admin
                </strong><br>

                <span
                    class="role-badge"
                    id="userRole"
                >
                    ADMIN
                </span>
            </div>

        </div>

    </div>

</header>


<section class="content">


<!-- =========================================================
     DASHBOARD
========================================================= -->

<div class="page active" id="dashboard">

    <div class="page-title">

        <h1 id="welcomeText">
            Good Evening, Admin 👋
        </h1>

        <p>
            Here's what's happening across your campus today.
        </p>

    </div>


    <div class="stats">

        <div class="stat-card">

            <div class="stat-info">
                <p>Total Students</p>
                <h2 id="totalStudents">2,548</h2>
            </div>

            <div class="stat-icon blue">
                👨‍🎓
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-info">
                <p>Faculty Members</p>
                <h2>186</h2>
            </div>

            <div class="stat-icon green">
                👨‍🏫
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-info">
                <p>Today's Attendance</p>
                <h2>92.5%</h2>
            </div>

            <div class="stat-icon orange">
                📋
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-info">
                <p>Active Courses</p>
                <h2>48</h2>
            </div>

            <div class="stat-icon purple">
                📚
            </div>

        </div>

    </div>


    <div class="card">

        <div class="card-header">

            <h3>Quick Actions</h3>

        </div>

        <div class="quick-actions">

            <div class="quick-action"
                 onclick="openModal('studentModal')">

                <div>👨‍🎓</div>
                <p>Add Student</p>

            </div>

            <div class="quick-action"
                 onclick="openPage('attendance')">

                <div>📋</div>
                <p>Mark Attendance</p>

            </div>

            <div class="quick-action"
                 onclick="openPage('fees')">

                <div>💰</div>
                <p>Fee Management</p>

            </div>

            <div class="quick-action"
                 onclick="openPage('events')">

                <div>🎉</div>
                <p>Campus Events</p>

            </div>

        </div>

    </div>


    <div class="grid-2">

        <div class="card">

            <div class="card-header">

                <h3>Attendance Analytics</h3>

                <select id="chartFilter">

                    <option>Weekly</option>
                    <option>Monthly</option>

                </select>

            </div>

            <canvas id="attendanceChart"></canvas>

        </div>


        <div class="card">

            <div class="card-header">

                <h3>Upcoming Events</h3>

                <span
                    class="view-all"
                    onclick="openPage('events')"
                >
                    View All
                </span>

            </div>


            <div class="event">

                <div class="event-date">
                    <strong>18</strong>
                    AUG
                </div>

                <div class="event-info">
                    <h4>Tech Symposium</h4>
                    <p>Auditorium • 10:00 AM</p>
                </div>

            </div>


            <div class="event">

                <div class="event-date">
                    <strong>21</strong>
