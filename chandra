<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Smart Campus Management System</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Inter,Arial,sans-serif;
}

:root{
    --primary:#2563eb;
    --primary-dark:#1d4ed8;
    --secondary:#0f172a;
    --background:#f1f5f9;
    --card:#ffffff;
    --text:#0f172a;
    --muted:#64748b;
    --border:#e2e8f0;
    --success:#16a34a;
    --warning:#f59e0b;
    --danger:#dc2626;
}

body.dark{
    --background:#0f172a;
    --card:#1e293b;
    --text:#f8fafc;
    --muted:#94a3b8;
    --border:#334155;
}

body{
    background:var(--background);
    color:var(--text);
    min-height:100vh;
    transition:.3s;
}

/* ================= LOGIN ================= */

#loginScreen{
    position:fixed;
    inset:0;
    background:
        radial-gradient(circle at 20% 20%,#2563eb 0,transparent 30%),
        radial-gradient(circle at 80% 80%,#06b6d4 0,transparent 30%),
        #0f172a;
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:9999;
}

.login-box{
    width:420px;
    max-width:92%;
    background:rgba(255,255,255,.96);
    padding:35px;
    border-radius:22px;
    box-shadow:0 30px 80px rgba(0,0,0,.3);
}

.login-logo{
    text-align:center;
    margin-bottom:25px;
}

.login-icon{
    width:65px;
    height:65px;
    margin:auto;
    background:var(--primary);
    color:white;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:32px;
    margin-bottom:15px;
}

.login-logo h1{
    color:#0f172a;
    margin-bottom:5px;
}

.login-logo p{
    color:#64748b;
    font-size:14px;
}

.login-group{
    margin-bottom:17px;
}

.login-group label{
    display:block;
    font-size:14px;
    font-weight:600;
    color:#334155;
    margin-bottom:7px;
}

.login-group input,
.login-group select{
    width:100%;
    padding:13px;
    border:1px solid #cbd5e1;
    border-radius:10px;
    outline:none;
}

.login-group input:focus,
.login-group select:focus{
    border-color:var(--primary);
}

.login-btn{
    width:100%;
    border:0;
    padding:14px;
    background:var(--primary);
    color:white;
    border-radius:10px;
    font-weight:bold;
    cursor:pointer;
    font-size:15px;
}

.login-btn:hover{
    background:var(--primary-dark);
}

.demo-accounts{
    margin-top:20px;
    padding:15px;
    background:#f1f5f9;
    border-radius:10px;
    font-size:12px;
    color:#475569;
}

.demo-accounts strong{
    color:#0f172a;
}

/* ================= SIDEBAR ================= */

.sidebar{
    position:fixed;
    left:0;
    top:0;
    width:250px;
    height:100vh;
    background:#0f172a;
    color:white;
    padding:20px 15px;
    z-index:1000;
    overflow-y:auto;
    transition:.3s;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:19px;
    font-weight:bold;
    margin-bottom:30px;
}

.logo-icon{
    width:40px;
    height:40px;
    background:var(--primary);
    border-radius:11px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.menu-title{
    color:#64748b;
    font-size:11px;
    text-transform:uppercase;
    margin:20px 10px 8px;
    font-weight:bold;
}

.nav-item{
    display:flex;
    align-items:center;
    gap:12px;
    padding:11px 12px;
    border-radius:9px;
    cursor:pointer;
    margin-bottom:4px;
    color:#cbd5e1;
    font-size:14px;
    transition:.2s;
}

.nav-item:hover,
.nav-item.active{
    background:#2563eb;
    color:white;
}

.nav-icon{
    width:20px;
    text-align:center;
}

/* ================= MAIN ================= */

.main{
    margin-left:250px;
    min-height:100vh;
}

.header{
    height:70px;
    background:var(--card);
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 28px;
    position:sticky;
    top:0;
    z-index:500;
}

.header-left{
    display:flex;
    align-items:center;
    gap:15px;
}

.mobile-menu{
    display:none;
    font-size:24px;
    cursor:pointer;
}

.search{
    width:330px;
    padding:10px 14px;
    border:1px solid var(--border);
    border-radius:9px;
    background:var(--background);
    color:var(--text);
    outline:none;
}

.header-right{
    display:flex;
    align-items:center;
    gap:18px;
}

.header-btn{
    background:transparent;
    border:0;
    color:var(--text);
    cursor:pointer;
    font-size:20px;
}

.profile{
    display:flex;
    align-items:center;
    gap:9px;
    font-size:14px;
}

.profile img{
    width:38px;
    height:38px;
    border-radius:50%;
}

.role-badge{
    background:#dbeafe;
    color:#1d4ed8;
    padding:4px 8px;
    border-radius:20px;
    font-size:10px;
    font-weight:bold;
}

/* ================= CONTENT ================= */

.content{
    padding:28px;
}

.page{
    display:none;
}

.page.active{
    display:block;
}

.page-title{
    margin-bottom:23px;
}

.page-title h1{
    font-size:28px;
    margin-bottom:5px;
}

.page-title p{
    color:var(--muted);
    font-size:14px;
}

/* ================= STATS ================= */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    margin-bottom:22px;
}

.stat-card{
    background:var(--card);
    border:1px solid var(--border);
    padding:20px;
    border-radius:15px;
    display:flex;
    justify-content:space-between;
    box-shadow:0 5px 20px rgba(0,0,0,.03);
}

.stat-info p{
    color:var(--muted);
    font-size:13px;
    margin-bottom:8px;
}

.stat-info h2{
    font-size:27px;
}

.stat-icon{
    width:46px;
    height:46px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:21px;
}

.blue{background:#dbeafe;color:#2563eb}
.green{background:#dcfce7;color:#16a34a}
.orange{background:#fef3c7;color:#d97706}
.purple{background:#ede9fe;color:#7c3aed}
.red{background:#fee2e2;color:#dc2626}

/* ================= CARDS ================= */

.grid-2{
    display:grid;
    grid-template-columns:2fr 1fr;
    gap:20px;
    margin-bottom:22px;
}

.card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:15px;
    padding:20px;
    box-shadow:0 5px 20px rgba(0,0,0,.03);
    margin-bottom:20px;
}

.card-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:18px;
}

.card-header h3{
    font-size:17px;
}

.view-all{
    color:var(--primary);
    cursor:pointer;
    font-size:13px;
}

/* ================= TABLE ================= */

.table-container{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:13px;
    text-align:left;
    border-bottom:1px solid var(--border);
    white-space:nowrap;
}

th{
    color:var(--muted);
    font-size:12px;
}

td{
    font-size:13px;
}

.status{
    padding:5px 9px;
    border-radius:20px;
    font-size:11px;
    display:inline-block;
    font-weight:600;
}

.status.active{
    background:#dcfce7;
    color:#166534;
}

.status.warning{
    background:#fef3c7;
    color:#92400e;
}

.status.danger{
    background:#fee2e2;
    color:#991b1b;
}

.status.info{
    background:#dbeafe;
    color:#1d4ed8;
}

/* ================= BUTTONS ================= */

.btn{
    border:0;
    padding:9px 14px;
    border-radius:8px;
    cursor:pointer;
    font-weight:600;
    font-size:13px;
}

.btn-primary{
    background:var(--primary);
    color:white;
}

.btn-primary:hover{
    background:var(--primary-dark);
}

.btn-danger{
    background:#fee2e2;
    color:#dc2626;
}

.btn-success{
    background:#dcfce7;
    color:#166534;
}

.btn-warning{
    background:#fef3c7;
    color:#92400e;
}

/* ================= EVENTS ================= */

.event{
    display:flex;
    gap:13px;
    padding:14px 0;
    border-bottom:1px solid var(--border);
}

.event:last-child{
    border:0;
}

.event-date{
    width:55px;
    min-width:55px;
    height:55px;
    background:#dbeafe;
    color:#2563eb;
    border-radius:10px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    font-weight:bold;
    font-size:11px;
}

.event-date strong{
    font-size:18px;
}

.event-info h4{
    margin-bottom:4px;
}

.event-info p{
    color:var(--muted);
    font-size:12px;
}

/* ================= NOTICES ================= */

.notice{
    padding:14px;
    border-left:4px solid var(--primary);
    background:var(--background);
    margin-bottom:10px;
    border-radius:5px;
}

.notice h4{
    font-size:14px;
    margin-bottom:4px;
}

.notice p{
    color:var(--muted);
    font-size:12px;
}

/* ================= FORMS ================= */

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
}

.form-group{
    margin-bottom:14px;
}

.form-group label{
    display:block;
    margin-bottom:6px;
    font-size:13px;
    font-weight:600;
}

.form-group input,
.form-group select{
    width:100%;
    padding:11px;
    border:1px solid var(--border);
    border-radius:8px;
    background:var(--background);
    color:var(--text);
    outline:none;
}

/* ================= QUICK ACTIONS ================= */

.quick-actions{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.quick-action{
    padding:17px;
    border:1px solid var(--border);
    border-radius:12px;
    cursor:pointer;
    text-align:center;
    transition:.2s;
}

.quick-action:hover{
    transform:translateY(-3px);
    border-color:var(--primary);
}

.quick-action div{
    font-size:25px;
    margin-bottom:7px;
}

.quick-action p{
    font-size:12px;
    color:var(--muted);
}

/* ================= MODAL ================= */

.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.65);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:3000;
}

.modal.show{
    display:flex;
}

.modal-content{
    width:520px;
    max-width:92%;
    background:var(--card);
    border-radius:16px;
    padding:25px;
    max-height:90vh;
    overflow-y:auto;
}

.modal-header{
    display:flex;
    justify-content:space-between;
    margin-bottom:20px;
}

.close{
    cursor:pointer;
    font-size:25px;
}

/* ================= TOAST ================= */

.toast{
    position:fixed;
    right:25px;
    bottom:25px;
    background:#0f172a;
    color:white;
    padding:14px 18px;
    border-radius:9px;
    transform:translateY(100px);
    opacity:0;
    transition:.3s;
    z-index:5000;
    font-size:13px;
}

.toast.show{
    transform:translateY(0);
    opacity:1;
}

/* ================= NOTIFICATION PANEL ================= */

.notification-panel{
    position:fixed;
    right:25px;
    top:70px;
    width:320px;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    box-shadow:0 20px 50px rgba(0,0,0,.15);
    padding:15px;
    display:none;
    z-index:2000;
}

.notification-panel.show{
    display:block;
}

.notification-item{
    padding:12px;
    border-bottom:1px solid var(--border);
}

.notification-item:last-child{
    border:0;
}

.notification-item strong{
    font-size:13px;
}

.notification-item p{
    color:var(--muted);
    font-size:11px;
    margin-top:4px;
}

/* ================= PROFILE ================= */

.profile-card{
    display:flex;
    align-items:center;
    gap:20px;
}

.large-avatar{
    width:90px;
    height:90px;
    border-radius:50%;
}

/* ================= RESPONSIVE ================= */

@media(max-width:1100px){

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .grid-2{
        grid-template-columns:1fr;
    }

    .quick-actions{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:768px){

    .sidebar{
        left:-250px;
    }

    .sidebar.show{
        left:0;
    }

    .main{
        margin-left:0;
    }

    .mobile-menu{
        display:block;
    }

    .search{
        width:200px;
    }

    .content{
        padding:18px;
    }

    .stats{
        grid-template-columns:1fr;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .profile span{
        display:none;
    }
}

@media(max-width:500px){

    .header{
        padding:0 15px;
    }

    .search{
        display:none;
    }

    .quick-actions{
        grid-template-columns:1fr 1fr;
    }

    .page-title h1{
        font-size:23px;
    }
}
</style>
</head>

<body>

<!-- =========================================================
     LOGIN SCREEN
========================================================= -->

<div id="loginScreen">

    <div class="login-box">

        <div class="login-logo">

            <div class="login-icon">
                🎓
            </div>

            <h1>SmartCampus</h1>

            <p>Campus Management System</p>

        </div>

        <form id="loginForm">

            <div class="login-group">

                <label>Username</label>

                <input
                    type="text"
                    id="loginUsername"
                    placeholder="Enter username"
                    required
                >

            </div>

            <div class="login-group">

                <label>Password</label>

                <input
                    type="password"
                    id="loginPassword"
                    placeholder="Enter password"
                    required
                >

            </div>

            <div class="login-group">

                <label>Login As</label>

                <select id="loginRole">

                    <option value="admin">Administrator</option>
                    <option value="faculty">Faculty</option>
                    <option value="student">Student</option>

                </select>

            </div>

            <button class="login-btn" type="submit">
                Login to Dashboard
            </button>

        </form>

        <div class="demo-accounts">

            <strong>Demo Accounts</strong><br><br>

            Admin: admin / admin123<br>
            Faculty: faculty / faculty123<br>
            Student: student / student123

        </div>

    </div>

</div>


<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside class="sidebar" id="sidebar">

    <div class="logo">

        <div class="logo-icon">🎓</div>

        SmartCampus

    </div>

    <div class="menu-title">
        Main Menu
    </div>

    <div class="nav-item active" data-page="dashboard">
        <span class="nav-icon">📊</span>
        Dashboard
    </div>

    <div class="nav-item admin-only" data-page="students">
        <span class="nav-icon">👨‍🎓</span>
        Students
    </div>

